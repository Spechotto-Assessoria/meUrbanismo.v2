# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os valores
# reais do seu projeto Supabase: Project Settings → Data API / API Keys.
#
# Depois de criar/editar o .env, reinicie o servidor do Vite (npm run dev)
# para que as variáveis sejam recarregadas.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
